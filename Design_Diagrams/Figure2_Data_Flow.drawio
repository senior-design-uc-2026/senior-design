<mxfile host="app.diagrams.net"><diagram name="Tiny Cloud  ·  Data-flow diagram" id="d"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageWidth="1560" pageHeight="1070" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&amp;quot;font-size:30px&amp;quot;&gt;Tiny Cloud  ·  Data-flow diagram&lt;/b&gt;&lt;br&gt;Goal: put an app built with a coding agent online at a private link in under 90 seconds, so only invited people can open it, with no login code and no viewer accounts." style="text;html=1;align=left;verticalAlign=top;fontFamily=Inter;fontSize=15;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1480" height="80" as="geometry"/></mxCell><mxCell id="zA" value="FLOW A  ·  DEPLOY  (owner path)   budget: link back in under 90 s  (US-01)" style="rounded=1;arcSize=3;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Inter;fontSize=15;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="140" width="1500" height="300" as="geometry"/></mxCell><mxCell id="zB" value="FLOW B  ·  LOG IN AND OPEN  (viewer path)   budgets: code email &lt; 10 s, app visible &lt; 60 s, wake &lt; 2 s, revoke &lt; 1 s  (US-03, US-04)" style="rounded=1;arcSize=3;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Inter;fontSize=15;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="1500" height="400" as="geometry"/></mxCell><mxCell id="a0" value="Owner or agent" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=16;fontStyle=1;ellipse;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="50" y="230" width="176" height="64" as="geometry"/></mxCell><mxCell id="a1" value="CLI or MCP server" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=16;fontStyle=1;rounded=1;arcSize=12;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="300" y="230" width="196" height="64" as="geometry"/></mxCell><mxCell id="a2" value="Control API" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=16;fontStyle=1;rounded=1;arcSize=12;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="550" y="230" width="196" height="64" as="geometry"/></mxCell><mxCell id="a3" value="Builder" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=16;fontStyle=1;rounded=1;arcSize=12;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="800" y="230" width="196" height="64" as="geometry"/></mxCell><mxCell id="a4" value="Docker" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=16;fontStyle=1;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;dashed=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1050" y="230" width="196" height="64" as="geometry"/></mxCell><mxCell id="a5" value="Postgres" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=16;fontStyle=1;shape=cylinder3;boundedLbl=1;size=10;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="568" y="360" width="160" height="66" as="geometry"/></mxCell><mxCell id="b0" value="Viewer" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=16;fontStyle=1;ellipse;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="50" y="670" width="176" height="64" as="geometry"/></mxCell><mxCell id="b1" value="Router" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=16;fontStyle=1;rounded=1;arcSize=12;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="550" y="670" width="196" height="64" as="geometry"/></mxCell><mxCell id="b2" value="Postgres" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=16;fontStyle=1;shape=cylinder3;boundedLbl=1;size=10;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="568" y="540" width="160" height="66" as="geometry"/></mxCell><mxCell id="b3" value="Resend" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=16;fontStyle=1;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;dashed=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="550" y="800" width="196" height="64" as="geometry"/></mxCell><mxCell id="b4" value="Sleeper" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=16;fontStyle=1;rounded=1;arcSize=12;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1050" y="560" width="196" height="64" as="geometry"/></mxCell><mxCell id="b5" value="App container" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=16;fontStyle=1;rounded=1;arcSize=12;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1050" y="670" width="196" height="64" as="geometry"/></mxCell><mxCell id="e0" value="&lt;b style=&quot;color:#2563EB&quot;&gt;1&lt;/b&gt; app folder" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=1.8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="a0" target="a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="&lt;b style=&quot;color:#2563EB&quot;&gt;2&lt;/b&gt; archive" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=1.8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="&lt;b style=&quot;color:#2563EB&quot;&gt;3&lt;/b&gt; checked archive" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=1.8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="&lt;b style=&quot;color:#2563EB&quot;&gt;4&lt;/b&gt; image, then running app" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=1.8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="&lt;b style=&quot;color:#2563EB&quot;&gt;5&lt;/b&gt; app record" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=1.8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=3 5;edgeStyle=none;" edge="1" parent="1" source="a2" target="a5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="&lt;b style=&quot;color:#2563EB&quot;&gt;6&lt;/b&gt; private link" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=1.8;exitX=0.12;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="a2" target="a0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="574" y="330"/><mxPoint x="139" y="330"/></Array></mxGeometry></mxCell><mxCell id="e6" value="&lt;b style=&quot;color:#2563EB&quot;&gt;1&lt;/b&gt; request, then typed email" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=1.8;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="b0" target="b1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="&lt;b style=&quot;color:#2563EB&quot;&gt;2&lt;/b&gt; invite check, code hash" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=1.8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=3 5;edgeStyle=none;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="&lt;b style=&quot;color:#2563EB&quot;&gt;3&lt;/b&gt; 6-digit code" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=1.8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="b1" target="b3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="&lt;b style=&quot;color:#2563EB&quot;&gt;4&lt;/b&gt; code email to inbox" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=1.8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b3" target="b0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="139" y="832"/></Array></mxGeometry></mxCell><mxCell id="e10" value="&lt;b style=&quot;color:#2563EB&quot;&gt;5&lt;/b&gt; typed code" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=1.8;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="b0" target="b1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="&lt;b style=&quot;color:#2563EB&quot;&gt;6&lt;/b&gt; wake if asleep" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=1.8;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b1" target="b4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="689"/><mxPoint x="900" y="592"/></Array></mxGeometry></mxCell><mxCell id="e12" value="&lt;b style=&quot;color:#2563EB&quot;&gt;7&lt;/b&gt; request + viewer email" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=1.8;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="b1" target="b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=1.8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Blue box: component we build&lt;br&gt;Dashed box: outside system&lt;br&gt;Yellow cylinder: data store&lt;br&gt;Dark oval: person&lt;br&gt;Number: step order; label: data crossing the arrow" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontFamily=Inter;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="820" y="910" width="700" height="140" as="geometry"/></mxCell><mxCell id="cap" value="Figure 2. Data-flow diagram. Numbers give the order; each label names the data crossing that arrow. After step 5 in Flow B, the viewer gets a session cookie and skips steps 1 to 5 on later visits." style="text;html=1;align=left;fontFamily=Inter;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="1026" width="1480" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>