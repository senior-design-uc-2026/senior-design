=0.5;entryY=1;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="c7" target="x1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="&lt;b style=&quot;color:#2563EB&quot;&gt;I11&lt;/b&gt; send code" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=1.8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Inter;fontSize=13;fontColor=#475569;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="c4" target="x2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Blue box: component we build&lt;br&gt;Dashed box: outside system&lt;br&gt;Yellow cylinder: data store&lt;br&gt;Dark oval: person&lt;br&gt;Solid arrow: request (caller to receiver)&lt;br&gt;Dotted arrow: database read or write" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontFamily=Inter;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="900" y="840" width="560" height="160" as="geometry"/></mxCell><mxCell id="cap" value="Figure 1. D0 block diagram. Each arrow points from caller to receiver and carries an interface ID from the interface table. I4 to I6 all carry deploy and invite requests." style="text;html=1;align=left;fontFamily=Inter;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="966" width="1420" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>