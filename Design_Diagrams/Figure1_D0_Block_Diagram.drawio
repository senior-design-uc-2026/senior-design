<mxfile host="app.diagrams.net"><diagram name="Tiny Cloud  ·  D0 block diagram" id="d"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageWidth="1500" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&amp;quot;font-size:30px&amp;quot;&gt;Tiny Cloud  ·  D0 block diagram&lt;/b&gt;&lt;br&gt;Goal: put an app built with a coding agent online at a private link in under 90 seconds, so only invited people can open it, with no login code and no viewer accounts." style="text;html=1;align=left;verticalAlign=top;fontFamily=Inter;fontSize=15;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1420" height="80" as="geometry"/></mxCell><mxCell id="zone" value="TINY CLOUD SERVER  (one rented Linux machine)" style="rounded=1;arcSize=3;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Inter;fontSize=15;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="290" y="140" width="1150" height="650" as="geometry"/></mxCell><mxCell id="owner" value="Owner" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=16;fontStyle=1;ellipse;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="50" y="254" width="180" height="60" as="geometry"/></mxCell><mxCell id="agent" value="Coding agent" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=16;fontStyle=1;ellipse;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="50" y="434" width="180" height="60" as="geometry"/></mxCell><mxCell id="viewer" value="Viewer" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=16;fontStyle=1;ellipse;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="50" y="684" width="180" height="60" as="geometry"/></mxCell><mxCell id="c1" value="C1  tiny CLI" style="whiteSpace=wrap;html=1;font